{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astra-backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8765"],
      "port": 8765,
      "autoPort": false
    },
    {
      "name": "astra-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "ASTRA_API_PORT=8765 npm --prefix frontend run dev"],
      "port": 5173
    }
  ]
}
